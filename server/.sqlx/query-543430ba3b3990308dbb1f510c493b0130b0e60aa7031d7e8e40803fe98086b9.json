  "query": "\n        SELECT \n            id, \n            cast(date as text) as date, \n            meal_type, \n            food_item_id,\n            food_name, \n            calories as \"calories!\", \n            protein as \"protein!\", \n            carbs as \"carbs!\", \n            fat as \"fat!\", \n            servings as \"servings!\"\n        FROM meal_logs\n        WHERE user_id = $1 AND date = $2\n        ",
