  "db_name": "SQLite",
  "query": "\n        SELECT \n            f.id, \n            f.name, \n            f.calories as \"calories!\", \n            f.protein as \"protein!\", \n            f.carbs as \"carbs!\", \n            f.fat as \"fat!\", \n            f.serving_unit as \"serving_unit!\", \n            f.serving_size as \"serving_size!\", \n            f.created_at\n        FROM food_items f\n        JOIN favorite_foods fav ON f.id = fav.food_item_id\n        WHERE fav.user_id = $1\n        ORDER BY f.name ASC\n        ",
